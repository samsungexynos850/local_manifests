<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="origin"
           fetch="https://github.com/LineageOS"
           revision="lineage-23.2" />

  <remote  name="muppets"
           fetch="https://github.com/TheMuppets"
           revision="lineage-23.2" />

  <!-- Device -->
  <project name="android_device_oneplus_lemonades" path="device/oneplus/lemonades" remote="origin" />
  <project name="android_device_oneplus_sm8250-common" path="device/oneplus/sm8250-common" remote="origin" />

  <!-- Vendor -->
  <project name="proprietary_vendor_oneplus_lemonades" path="vendor/oneplus/lemonades" remote="muppets" />
  <project name="proprietary_vendor_oneplus_sm8250-common" path="vendor/samsung/sm8250-common" remote="muppets" />

  <!-- Kernel -->
  <project name="android_kernel_oneplus_sm8250" path="kernel/oneplus/sm8250" remote="origin" />

  <!-- Hardware -->
  <project name="android_hardware_oplus" path="hardware/oplus" remote="origin" />

</manifest>
